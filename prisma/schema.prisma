// =====================================================================
// ClinicPulse — Production Prisma schema (Postgres / Neon / Supabase)
// =====================================================================
// This file mirrors `shared/schema.ts` (Drizzle) and is provided so the
// codebase can be migrated to a Vercel + Neon/Supabase deployment with
// `prisma migrate dev` / `prisma db push`.
//
// The preview build uses Drizzle + better-sqlite3 because the sandbox
// requires a single-file embedded DB. In production, swap the storage
// layer to Prisma and point DATABASE_URL at Postgres.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Tenancy -------------------------------------------------------

model Clinic {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  plan      String    @default("Pro")
  createdAt DateTime  @default(now())
  branches  Branch[]
  users     User[]
  patients  Patient[]
}

model Branch {
  id        Int     @id @default(autoincrement())
  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  clinicId  Int
  name      String
  city      String
  address   String
  phone     String
  users     User[]
  visits    Visit[]
  inventory Medicine[]
  appointments Appointment[]
}

// ----- Identity & Access --------------------------------------------

enum Role {
  admin
  doctor
  receptionist
  pharmacist
  patient
}

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  fullName    String
  passwordHash String
  role        Role
  clinic      Clinic     @relation(fields: [clinicId], references: [id])
  clinicId    Int
  branch      Branch?    @relation(fields: [branchId], references: [id])
  branchId    Int?
  specialty   String?
  twoFactor   Boolean    @default(false)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  sessions    Session[]
  passwordResetTokens PasswordResetToken[]
  audits      AuditLog[]
  prescriptions Prescription[] @relation("DoctorRx")
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  ip        String
  userAgent String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}

// ----- Clinical -----------------------------------------------------

model Patient {
  id           Int            @id @default(autoincrement())
  clinic       Clinic         @relation(fields: [clinicId], references: [id])
  clinicId     Int
  mrn          String         @unique
  fullName     String
  gender       String
  dob          DateTime
  bloodGroup   String?
  phone        String
  email        String?
  address      String?
  allergies    String[]
  chronic      String[]
  createdAt    DateTime       @default(now())
  visits       Visit[]
  prescriptions Prescription[]
  appointments Appointment[]
  payments     Payment[]
}

model Visit {
  id         Int      @id @default(autoincrement())
  patient    Patient  @relation(fields: [patientId], references: [id])
  patientId  Int
  branch     Branch   @relation(fields: [branchId], references: [id])
  branchId   Int
  date       DateTime
  vitals     Json
  soapS      String?
  soapO      String?
  soapA      String?
  soapP      String?
  prescription Prescription?
}

// ----- Pharmacy -----------------------------------------------------

model Medicine {
  id          Int      @id @default(autoincrement())
  branch      Branch   @relation(fields: [branchId], references: [id])
  branchId    Int
  name        String
  generic     String
  company     String
  unit        String
  purchasePrice Decimal @db.Decimal(10,2)
  salePrice    Decimal  @db.Decimal(10,2)
  stock        Int
  reorderLevel Int      @default(20)
  expiry       DateTime?
  logs         InventoryLog[]
  rxItems      PrescriptionItem[]
}

enum InvOp { in_ out_ adjust }

model InventoryLog {
  id         Int      @id @default(autoincrement())
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  medicineId Int
  op         InvOp
  qty        Int
  reason     String?
  createdAt  DateTime @default(now())
}

// ----- Prescriptions ------------------------------------------------

model Prescription {
  id         Int       @id @default(autoincrement())
  patient    Patient   @relation(fields: [patientId], references: [id])
  patientId  Int
  visit      Visit?    @relation(fields: [visitId], references: [id])
  visitId    Int?      @unique
  doctor     User      @relation("DoctorRx", fields: [doctorId], references: [id])
  doctorId   Int
  diagnosis  String
  notes      String?
  date       DateTime  @default(now())
  items      PrescriptionItem[]
  payment    Payment?
}

model PrescriptionItem {
  id         Int     @id @default(autoincrement())
  rx         Prescription @relation(fields: [rxId], references: [id])
  rxId       Int
  medicine   Medicine     @relation(fields: [medicineId], references: [id])
  medicineId Int
  dose       String
  frequency  String
  duration   String
  instructions String?
}

// ----- Scheduling ---------------------------------------------------

enum ApptStatus { scheduled checkedIn inProgress completed cancelled noShow }

model Appointment {
  id        Int        @id @default(autoincrement())
  patient   Patient    @relation(fields: [patientId], references: [id])
  patientId Int
  branch    Branch     @relation(fields: [branchId], references: [id])
  branchId  Int
  doctorId  Int
  doctorName String
  start     DateTime
  end       DateTime
  reason    String
  status    ApptStatus @default(scheduled)
  source    String?
}

// ----- Finance ------------------------------------------------------

model Payment {
  id         Int       @id @default(autoincrement())
  patient    Patient   @relation(fields: [patientId], references: [id])
  patientId  Int
  rx         Prescription? @relation(fields: [rxId], references: [id])
  rxId       Int?      @unique
  amount     Decimal   @db.Decimal(12,2)
  method     String
  status     String
  date       DateTime  @default(now())
}

model Expense {
  id        Int      @id @default(autoincrement())
  branchId  Int
  category  String
  vendor    String?
  amount    Decimal  @db.Decimal(12,2)
  date      DateTime @default(now())
  notes     String?
}

// ----- Notifications ------------------------------------------------

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  channel   String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
